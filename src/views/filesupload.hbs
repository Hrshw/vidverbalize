<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Video Transcription and Captioning</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
  <link rel="stylesheet" href="styles.css">
  <style>
    /* Custom gradient background */
    body {
      background: linear-gradient(45deg, #007BFF, #FFA500, #007BFF, #FFA500);
      background-size: 400% 400%;
      animation: gradient 10s ease infinite;
    }

    /* Gradient animation */
    @keyframes gradient {
      0% {
        background-position: 0% 50%;
      }

      50% {
        background-position: 100% 50%;
      }

      100% {
        background-position: 0% 50%;
      }
    }

    /* Style for the button */
    .gradient-button {
      background: linear-gradient(45deg, #007BFF, #FFA500);
      border: none;
      color: white;
    }

    /* Style for the form container */
    .form-container {
      background-color: rgba(255, 255, 255, 0.9);
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);
    }
  </style>
</head>

<body>
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="form-container">
          <h1 class="text-center">Video Transcription and Captioning</h1>
          <form action="/process-video" method="POST" enctype="multipart/form-data" id="uploadForm">
            <div class="mb-3">
              <label for="inputType" class="form-label">Select Input Type</label>
              <select class="form-select" id="inputType" name="inputType">
                <option value="videoUrl">Video Link 📺</option>
                <option value="uploadFile">Upload Video File 📁</option>
              </select>

            </div>
            <div class="mb-3" id="videoUrlField">
              <label for="videoUrl" class="form-label">Video Url</label>
              <input type="text" class="form-control" id="videoUrl" name="videoUrl" required>
            </div>
            <div class="mb-3" id="videoUploadField" style="display: none;">
              <label for="videoFile" class="form-label">Upload Video File</label>
              <input type="file" class="form-control" id="videoFile" name="videoFile">
            </div>
            <button type="submit" class="btn gradient-button">Process Video</button>
          </form>
        </div>
      </div>
    </div>
     <div class="row mt-4 justify-content-center">
      <div class="col-md-10">
        <div id="downloadLinks">
          {{#each videos}}
            <video controls width="40%">
              <source src="{{video_url}}" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/popper.js@2.11.6/dist/umd/popper.min.js"
    integrity="sha384-oBqDVmMz9ATKxIep9tiCxS/Z9fNfEXiDAYTujMAeBAsjFuCZSmKbSSUnQlmh/jp3"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js"
    integrity="sha384-cuYeSxntonz0PPNlHhBs68uyIAVpIIOZZ5JqeqvYYIcEL727kskC66kF92t6Xl2V"
    crossorigin="anonymous"></script>
  <script>
    const inputType = document.getElementById('inputType');
    const userInputField = document.getElementById('videoUrlField');
    const videoUploadField = document.getElementById('videoUploadField');
    const videoUrlInput = document.getElementById('videoUrl');

    inputType.addEventListener('change', function () {
      const selectedInputType = this.value;

      // Hide both input fields by default
      userInputField.style.display = 'none';
      videoUploadField.style.display = 'none';

      // Remove "required" attribute from videoUrlInput
      videoUrlInput.removeAttribute('required');

      if (selectedInputType === 'videoUrl') {
        userInputField.style.display = 'block'; // Show the YouTube input field
        videoUploadField.style.display = 'none'; // Hide the file upload input
      } else if (selectedInputType === 'uploadFile') {
        userInputField.style.display = 'none'; // Hide the YouTube input field
        videoUploadField.style.display = 'block'; // Show the file upload input
        videoUrlInput.value = ''; // Clear the video URL input
      }
    });

    // Additional JavaScript code to handle form submission
    const uploadForm = document.getElementById('uploadForm');
    uploadForm.addEventListener('submit', function (event) {
      const selectedInputType = inputType.value;
      const userInput = document.getElementById('videoUrl').value;
      const videoFile = document.getElementById('videoFile').files[0];

      if (selectedInputType === 'videoUrl') {
        // Ensure the YouTube Link field is not empty
        if (!userInput) {
          event.preventDefault();
          alert('Please enter a video URL.');
        }
      } else if (selectedInputType === 'uploadFile') {
        // Ensure a video file is selected
        if (!videoFile) {
          event.preventDefault();
          alert('Please select a video file for upload.');
        }
      }
    });
  </script>

</body>

</html>